# Explicitly set Python files as Python
*.py linguist-language=Python

# Mark these as documentation or generated (so they don't count toward the primary language)
*.md linguist-documentation
*.html linguist-generated
*.htm linguist-generated
*.css linguist-generated
*.js linguist-generated
*.json linguist-generated
*.png linguist-generated
*.jpg linguist-generated
*.jpeg linguist-generated
*.gif linguist-generated
LICENSE linguist-documentation

